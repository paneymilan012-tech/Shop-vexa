# ShopVexa - Environment Configuration Example
# Tagline: Shop Smart. Live Better.

# Server Port (Default: 3000)
PORT=3000

# Application URL
APP_URL="http://localhost:3000"

# Optional: Gemini AI API Key (If enabling generative product descriptions)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NOTE ON PAYMENTS:
# ShopVexa runs out-of-the-box with an integrated Test Mode Gateway:
# - Credit & Debit Cards (Simulated test sandbox with instant RuPay/Visa/Mastercard validation; raw card data is never stored on disk)
# - UPI QR / VPA simulator (Google Pay, PhonePe, Paytm, BHIM)
# - Cash on Delivery (COD) with verification OTP
#
# Production Note: To connect live real-world merchant processing, plug in your gateway keys:
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="..."
